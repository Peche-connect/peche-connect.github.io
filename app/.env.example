# Copier ce fichier en « .env » (jamais envoyé sur GitHub : il est dans .gitignore) puis remplir.
# Sans ces deux lignes, l'appli reste en MODE DÉMO (données sur le téléphone, aucun paiement réel).

# Supabase > Project Settings > API : « Project URL » et clé « anon public » (publique par nature,
# la sécurité vient des règles d'accès de la base). Ne JAMAIS mettre ici la clé « service_role ».
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Adresse du site (liens des QR codes et retours de paiement)
EXPO_PUBLIC_SITE_URL=https://peche-connect.github.io

# Modes de connexion : Google (gratuit, activé par défaut) et/ou code par SMS (payant, désactivé par défaut)
EXPO_PUBLIC_CONNEXION_GOOGLE=1
EXPO_PUBLIC_CONNEXION_SMS=0

# Notifications sur téléphone (appli installée) : identifiant du projet Expo (EAS), facultatif
EXPO_PUBLIC_EAS_PROJECT_ID=
