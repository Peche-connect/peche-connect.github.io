# Copier ce fichier en « .env » (jamais envoyé sur GitHub : il est dans .gitignore), puis remplir.
# Sans les clés Firebase, l'appli reste en MODE DÉMO (données sur le téléphone, aucun paiement réel).

# Console Firebase > Paramètres du projet > Vos applications > Application Web (</>) > « Configuration ».
# Ces valeurs sont publiques par nature : la sécurité vient des règles d'accès (app/firebase/*.rules).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=peche-connect.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=peche-connect
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=peche-connect.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Adresse du site (liens des QR codes et retours de paiement)
EXPO_PUBLIC_SITE_URL=https://peche-connect.fr

# Modes de connexion (gratuits) : Google et lien par e-mail activés ; Apple à activer avec le compte Apple Developer
EXPO_PUBLIC_CONNEXION_GOOGLE=1
EXPO_PUBLIC_CONNEXION_EMAIL=1
EXPO_PUBLIC_CONNEXION_APPLE=0

# Notifications sur téléphone (appli installée) : identifiant du projet Expo (EAS)
EXPO_PUBLIC_EAS_PROJECT_ID=
