{
  "firestore": { "rules": "firestore.rules", "indexes": "firestore.indexes.json", "location": "europe-west9" },
  "storage": { "rules": "storage.rules" },
  "functions": [
    { "source": "functions", "codebase": "peche-connect", "runtime": "nodejs20",
      "ignore": ["node_modules", ".git", "src", "*.log"],
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"] }
  ],
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "storage": { "port": 9199 },
    "functions": { "port": 5001 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
