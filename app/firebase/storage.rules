rules_version = '2';
// Pêche Connect · règles d'accès des fichiers (Cloud Storage)
service firebase.storage {
  match /b/{seau}/o {

    // Photos des arrivages : publiques UNE FOIS NETTOYÉES par le serveur (position GPS et autres
    // métadonnées effacées, fonction photoDeposee) ; l'original n'est jamais lisible.
    // Seul le pêcheur de l'étal dépose (image, 5 Mo max), sans pouvoir se déclarer « nettoyé ».
    match /arrivages/{etal}/{fichier} {
      allow read: if resource.metadata != null && resource.metadata.nettoye == '1';
      allow create: if request.auth != null && request.auth.token.etalId == etal
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && (request.resource.metadata == null || !('nettoye' in request.resource.metadata));
    }

    // Messages vocaux : privés, seulement les deux participants de la conversation (2 Mo max)
    match /messages-audio/{conv}/{fichier} {
      function participant() {
        return request.auth != null
          && request.auth.uid in firestore.get(/databases/(default)/documents/conversations/$(conv)).data.participants;
      }
      allow read: if participant();
      allow create: if participant()
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
    }

    // PDF des factures : écrits seulement par le serveur, lus par l'acheteur et le vendeur
    match /factures/{fichier} {
      allow read: if request.auth != null && (resource.metadata.proId == request.auth.uid || resource.metadata.pecheurId == request.auth.uid);
      allow write: if false;
    }

    match /{autre=**} {
      allow read, write: if false;
    }
  }
}
