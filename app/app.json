{
  "expo": {
    "name": "Pêche Connect",
    "slug": "peche-connect",
    "scheme": "pecheconnect",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "fr.pecheconnect.app",
      "supportsTablet": false
    },
    "android": {
      "package": "fr.pecheconnect.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icones/adaptive-icon.png",
        "backgroundColor": "#12355b"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Pêche Connect",
      "themeColor": "#12355b",
      "favicon": "./assets/icones/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": false,
      "baseUrl": ""
    },
    "icon": "./assets/icones/icon.png",
    "splash": {
      "image": "./assets/icones/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#12355b"
    }
  }
}
